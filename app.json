{
  "expo": {
    "name": "Água Gestão",
    "slug": "agua-gestao-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#061325"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.aguagestao.app"
    },
    "android": {
      "package": "br.com.aguagestao.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#061325"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": []
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir acesso à localização para registrar as coordenadas GPS de entrega dos clientes."
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "apiUrl": "https://aguagestao-api.loca.lt/api",
      "productionApiUrl": "https://aguagestao.com.br/api",
      "eas": {
        "projectId": "291f2486-e43a-44ac-b44a-419c7bb66201"
      }
    },
    "owner": "hudraf"
  }
}
